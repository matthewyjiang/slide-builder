(version 1)
(deny default)

; XNU passes argument-taking sysctls to MAC policy with the PID appended, e.g.
; kern.procargs2.123. Cover both legacy procargs interfaces and process inspection.
; These explicit denials are under native sentinel qualification.
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
(deny process-info*)

; macOS 15 dyld ignition opens a root-directory descriptor before locating its
; shared cache. Native CI otherwise aborts even /usr/bin/true in boot_boot.
; This permits the root directory itself, never its children or their contents.
(allow file-read-data (literal "/"))

; Only the chosen worker may execute. No subprocesses, network, Mach service
; lookup, user files, credentials, project trees, or writable directory grants.
(allow process-exec (literal (param "EXECUTABLE")))
(allow file-read*
    (literal (param "EXECUTABLE"))
    (literal (param "INPUT"))
    (literal "/dev/null")
    (literal "/dev/random")
    (literal "/dev/urandom")
    (subpath "/usr/lib")
    (subpath "/System/Library")
    (subpath "/Library/Apple/System/Library"))
(allow file-map-executable
    (literal (param "EXECUTABLE"))
    (subpath "/usr/lib")
    (subpath "/System/Library")
    (subpath "/Library/Apple/System/Library"))
(allow file-write-data (literal (param "OUTPUT")))
; V8 CPU feature and allocation sizing queries, plus loader OS/ABI queries.
; Never grant all sysctls: process-argument queries can expose host secrets.
(allow sysctl-read
    (sysctl-name "hw.activecpu")
    (sysctl-name "hw.ncpu")
    (sysctl-name "hw.logicalcpu_max")
    (sysctl-name "hw.physicalcpu_max")
    (sysctl-name "hw.memsize")
    (sysctl-name "hw.pagesize")
    (sysctl-name "hw.pagesize_compat")
    (sysctl-name "hw.cputype")
    (sysctl-name "hw.cpufamily")
    (sysctl-name "kern.osrelease")
    (sysctl-name "kern.osversion")
    (sysctl-name "kern.osproductversion")
    (sysctl-name "kern.tcsm_available")
    (sysctl-name-prefix "hw.optional."))
(allow signal (target self))
